# Copy this file to .env and change the values before running `docker compose up`.

# SQL Server SA password. Must meet SQL Server complexity rules:
# at least 8 characters including uppercase, lowercase, digits and/or symbols.
MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# JWT signing key for the REST API (HS256). Use at least 32 random characters.
JWT_KEY=change-me-to-a-random-string-of-32-plus-characters

# Seeded demo/admin account passwords.
# Keep ADMIN_PASSWORD empty unless you intentionally want to seed an admin locally.
DEMO_PASSWORD=Demo123!
ADMIN_PASSWORD=
