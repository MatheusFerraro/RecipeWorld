@model worldRecipeMvc.Models.ViewModels.PaginationViewModel

@if (Model.TotalPages > 1)
{
    int windowStart = Math.Max(1, Model.CurrentPage - 2);
    int windowEnd = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.RouteValuesForPage(Model.CurrentPage - 1)" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>

            @if (windowStart > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.RouteValuesForPage(1)">1</a>
                </li>
                @if (windowStart > 2)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
            }

            @for (int i = windowStart; i <= windowEnd; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.RouteValuesForPage(i)">@i</a>
                </li>
            }

            @if (windowEnd < Model.TotalPages)
            {
                @if (windowEnd < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
                <li class="page-item">
                    <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.RouteValuesForPage(Model.TotalPages)">@Model.TotalPages</a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.RouteValuesForPage(Model.CurrentPage + 1)" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
}
