@model worldRecipeMvc.Models.Recipe
@{
    ViewData["Title"] = "Change Status";
}

<h1>Change Recipe Status</h1>
<h4>@Model.RecipeName</h4>
<hr />

<form asp-action="ChangeStatus" asp-route-id="@Model.RecipeID" method="post">
    <div class="form-group">
        <label class="control-label">Status</label>
        <select name="status" class="form-control" asp-items="ViewBag.StatusList">
            <option value="">-- Select Status --</option>
        </select>
    </div>
    <div class="form-group mt-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Details" asp-route-id="@Model.RecipeID" class="btn btn-secondary">Cancel</a>
    </div>
</form>
