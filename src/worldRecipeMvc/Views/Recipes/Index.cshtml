@using Microsoft.AspNetCore.Identity
@using worldRecipeMvc.Data
@inject SignInManager<RecipeWorldUser> SignInManager
@inject UserManager<RecipeWorldUser> UserManager
@model worldRecipeMvc.Models.ViewModels.RecipesIndexViewModel

@{
    ViewData["Title"] = "Recipes";
}

<div class="container-fluid">
    <div class="row mb-3 align-items-center">
        <div class="col-md-6">
            <h1 class="mb-0">@ViewData["Title"]</h1>
            <p class="text-muted">@Model.TotalCount recipe(s) found</p>
        </div>
        <div class="col-md-6 text-end">
            @if (SignInManager.IsSignedIn(User))
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create New Recipe
                </a>
            }
        </div>
    </div>

    @if (TempData["SaveConfirmation"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["SaveConfirmation"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search and Filter Bar -->
    <div class="search-filter-bar">
        <form asp-action="Index" method="get">
            <div class="row g-3">
                <div class="col-md-4">
                    <input type="text" 
                           name="searchTerm" 
                           class="form-control" 
                           placeholder="Search recipes..." 
                           value="@Model.SearchTerm">
                </div>
                <div class="col-md-3">
                    <select name="categoryFilter" class="form-select">
                        <option value="">All Categories</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.CategoryID" 
                                    selected="@(Model.CategoryFilter == category.CategoryID)">
                                @category.CategoryName
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="statusFilter" class="form-select">
                        <option value="">All Status</option>
                        @foreach (var status in worldRecipeMvc.Models.RecipeStatus.All)
                        {
                            <option value="@status" selected="@(Model.StatusFilter == status)">@status</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </div>
        </form>
    </div>

    @if (!Model.Recipes.Any())
    {
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">No recipes found</h4>
            <p>There are currently no recipes matching your criteria.</p>
            @if (SignInManager.IsSignedIn(User))
            {
                <hr>
                <p class="mb-0">
                    <a asp-action="Create" class="btn btn-primary">Create the first recipe!</a>
                </p>
            }
        </div>
    }
    else
    {
        <!-- Recipe Cards Grid -->
        <div class="card-grid">
            @foreach (var item in Model.Recipes)
            {
                <partial name="_RecipeCard" model="item" />
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="pagination-wrapper">
                <div class="pagination-info">
                    Showing @((Model.PageNumber - 1) * Model.PageSize + 1) to
                    @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) of
                    @Model.TotalCount recipes
                </div>
                <partial name="_Pagination" model='new worldRecipeMvc.Models.ViewModels.PaginationViewModel
                {
                    CurrentPage = Model.PageNumber,
                    TotalPages = Model.TotalPages,
                    Action = "Index",
                    RouteValues = new Dictionary<string, string?>
                    {
                        ["searchTerm"] = Model.SearchTerm,
                        ["categoryFilter"] = Model.CategoryFilter?.ToString(),
                        ["statusFilter"] = Model.StatusFilter
                    }
                }' />
            </div>
        }
    }
</div>