@model worldRecipeMvc.Models.Ingredient

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Ingredient</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" asp-route-id="@Model.IngredientID">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IngredientID" />
            <div class="form-group">
                <label asp-for="IngredientName" class="control-label"></label>
                <input asp-for="IngredientName" class="form-control" />
                <span asp-validation-for="IngredientName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IngredientType" class="control-label"></label>
                <input asp-for="IngredientType" class="form-control" />
                <span asp-validation-for="IngredientType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IngredientDetails" class="control-label"></label>
                <input asp-for="IngredientDetails" class="form-control" />
                <span asp-validation-for="IngredientDetails" class="text-danger"></span>
            </div>
            <!-- Read-only approval status -->
            <div class="form-group">
                <label>Approval Status</label>
                <div>
                    @if (Model.IsApproved == true)
                    {
                        <span class="badge bg-success">Approved</span>
                    }
                    else if (Model.IsApproved == false)
                    {
                        <span class="badge bg-danger">Rejected</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Pending</span>
                    }
                    <small class="text-muted d-block">Editing content resets status to Pending.</small>
                </div>
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
