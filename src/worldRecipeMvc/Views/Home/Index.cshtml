@model worldRecipeMvc.Models.ViewModels.HomeTrendingViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="hero-section">
    <div class="container">
        <h1>Welcome to Recipe World</h1>
        <p class="lead">Discover delicious recipes from around the world!</p>
        <a asp-controller="Recipes" asp-action="Index" class="btn btn-light btn-lg">
            <i class="bi bi-search"></i> Explore Recipes
        </a>
    </div>
</div>

<div class="container">
    <div class="row">
        <!-- Top Rated Section -->
        <div class="col-lg-8 mb-4">
            <h2 class="mb-4">
                <i class="bi bi-star-fill text-warning"></i> Top Rated Recipes
            </h2>
            @if (Model.TopRated.Any())
            {
                <div class="row">
                    @foreach (var recipe in Model.TopRated)
                    {
                        <div class="col-md-6 mb-3">
                            <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.RecipeID" class="text-decoration-none">
                                <div class="card featured-recipe-card h-100">
                                    <img src="@(recipe.ImageUrl ?? "/WebsiteImages/RecipeDefaultImageNotAvailable.png")"
                                         class="card-img-top"
                                         alt="@recipe.RecipeName"
                                         style="height: 200px; object-fit: cover;"
                                         onerror="this.src='/WebsiteImages/RecipeDefaultImageNotAvailable.png'">
                                    <div class="card-body">
                                        <h5 class="card-title text-dark">@recipe.RecipeName</h5>
                                        <p class="card-text text-muted small mb-1">
                                            <i class="bi bi-star-fill text-warning"></i>
                                            @(recipe.AverageRating?.ToString("0.0") ?? "-") (@recipe.RatingCount review@(recipe.RatingCount == 1 ? "" : "s"))
                                        </p>
                                        @if (recipe.CategoryName != null)
                                        {
                                            <span class="badge" style="background-color: #93B7BE; color: white;">@recipe.CategoryName</span>
                                        }
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    No rated recipes yet — be the first to <a asp-controller="Recipes" asp-action="Index">rate a recipe</a>!
                </div>
            }
        </div>

        <!-- Most Favorited Sidebar -->
        <div class="col-lg-4 mb-4">
            <h2 class="mb-4">
                <i class="bi bi-heart-fill text-danger"></i> Most Favorited
            </h2>
            @if (Model.MostFavorited.Any())
            {
                @foreach (var recipe in Model.MostFavorited)
                {
                    <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.RecipeID" class="text-decoration-none">
                        <div class="card popular-recipe-card mb-3">
                            <img src="@(recipe.ImageUrl ?? "/WebsiteImages/RecipeDefaultImageNotAvailable.png")"
                                 class="card-img-top"
                                 alt="@recipe.RecipeName"
                                 style="height: 140px; object-fit: cover;"
                                 onerror="this.src='/WebsiteImages/RecipeDefaultImageNotAvailable.png'">
                            <div class="card-body">
                                <h5 class="card-title text-dark">@recipe.RecipeName</h5>
                                <p class="card-text text-muted small mb-0">
                                    <i class="bi bi-heart-fill text-danger"></i> @recipe.FavoriteCount favorite@(recipe.FavoriteCount == 1 ? "" : "s")
                                </p>
                            </div>
                        </div>
                    </a>
                }
            }
            else
            {
                <div class="alert alert-info">
                    No favorites yet — sign in and start bookmarking recipes you love!
                </div>
            }
        </div>
    </div>

    <!-- Quick Links Section -->
    <div class="row mt-4 mb-5">
        <div class="col-md-4 mb-3">
            <div class="card h-100 text-center" style="border-color: #93B7BE;">
                <div class="card-body">
                    <i class="bi bi-book display-3" style="color: #93B7BE;"></i>
                    <h4 class="card-title mt-3">Browse Recipes</h4>
                    <p class="card-text">Explore our collection of delicious recipes from around the world.</p>
                    <a asp-controller="Recipes" asp-action="Index" class="btn btn-primary">
                        View All Recipes
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100 text-center" style="border-color: #93B7BE;">
                <div class="card-body">
                    <i class="bi bi-grid display-3" style="color: #93B7BE;"></i>
                    <h4 class="card-title mt-3">Categories</h4>
                    <p class="card-text">Discover recipes organized by category - desserts, mains, and more!</p>
                    <a asp-controller="Categories" asp-action="Index" class="btn btn-primary">
                        View Categories
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100 text-center" style="border-color: #93B7BE;">
                <div class="card-body">
                    <i class="bi bi-basket display-3" style="color: #93B7BE;"></i>
                    <h4 class="card-title mt-3">Ingredients</h4>
                    <p class="card-text">Browse ingredients and find recipes using what you have on hand.</p>
                    <a asp-controller="Ingredients" asp-action="Index" class="btn btn-primary">
                        View Ingredients
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
