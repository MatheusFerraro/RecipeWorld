{
  "ConnectionStrings": {
    "RecipeWorldConnectionString": "Server=(local);Database=WorldRecipeDb;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=false"
  },
  "ImageUpload": {
    "StoragePath": ""
  },
  "SeedData": {
    "Enabled": true,
    "DemoEmail": "demo@recipeworld.com",
    "AdminEmail": "admin@recipeworld.com"
  },
  "Jwt": {
    "Issuer": "RecipeWorld",
    "Audience": "RecipeWorldApi",
    "ExpiryMinutes": 60,
    "Key": ""
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "AuthPermitLimit": 5,
    "WindowSeconds": 60
  },
  "UseHttpsRedirection": true,
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
